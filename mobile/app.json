{
  "expo": {
    "name": "Preisfuchs",
    "slug": "preisfuchs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "preisfuchs",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "de.preisfuchs.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "de.preisfuchs.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Preisfuchs nutzt deinen Standort nur, um Märkte in deiner Nähe zu finden. Er bleibt auf deinem Gerät."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Preisfuchs nutzt die Kamera nur für ein Foto vom Preisschild, wenn du einen Preis meldest.",
          "photosPermission": "Preisfuchs nutzt deine Fotos nur, wenn du ein Foto vom Preisschild zu einer Preismeldung hinzufügst."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Preisfuchs nutzt die Kamera, um Barcodes von Produkten zu scannen und Fotos von Preisschildern aufzunehmen.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.403196816446-ao4oapmnruuvop7la5lf8p01tf3b306a"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
