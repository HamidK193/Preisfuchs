// Vorlage: nach Config/Secrets.xcconfig kopieren und ausfuellen.
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
// Secrets.xcconfig NIE committen (steht in .gitignore).
// Nur den oeffentlichen anon-Key eintragen, NIEMALS den Service-Role-Key.

// Host ohne "https://", z. B. abcdefgh.supabase.co
SUPABASE_HOST = YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// Optional, nur fuer kostenlose Signierung auf dem eigenen iPhone:
// DEVELOPMENT_TEAM = YOUR-PERSONAL-TEAM-ID
// PF_BUNDLE_ID = de.preisfuchs.app.dev
