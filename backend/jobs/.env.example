SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPEN_PRICES_BASE_URL=https://prices.openfoodfacts.org
PRICEFUCHS_DRY_RUN=0
# Only publishes observations whose article and price checks have passed.
PRICEFUCHS_PUBLISH_REVIEWED=false
# Optional local report/review queue path; never place it in a public web directory.
# PRICEFUCHS_REPORT_PATH=artifacts/latest-import.json
# The production job rejects this flag until a licensed adapter exists.
ENABLE_UNLICENSED_KAUFDA_IMPORT=false
